{
    "name": "wwsrapport/php-client",
    "description": "Official PHP SDK for creating WWS reports, retrieving report documents, managing webhooks, and integrating with the WWSrapport API.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "wwsrapport",
        "wws",
        "huurprijs",
        "real-estate",
        "api-client"
    ],
    "homepage": "https://wwsrapport.nl/api",
    "support": {
        "docs": "https://wwsrapport.nl/api/docs"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Used by WwsrapportClient::create() as the default PSR-18 HTTP client.",
        "nyholm/psr7": "Used by WwsrapportClient::create() as the default PSR-17 request and stream factory."
    },
    "autoload": {
        "psr-4": {
            "Wwsrapport\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wwsrapport\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
